# --- Banco de Dados (MySQL) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=atualizacao_cadastral
MYSQL_USER=codego_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Backend (FastAPI) ---
APP_ENV=development
APP_SECRET_KEY=change_me_secret

# --- Armazenamento de arquivos ---
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Protocolo ---
PROTOCOL_PREFIX=ATC

# --- Notificação por e-mail ---
# TODAS as solicitações de atualização cadastral são enviadas para este e-mail
# fixo (o e-mail da empresa), com os PDFs de CNPJ e Contrato Social em anexo.
NOTIFICATION_EMAIL=

# --- E-mail ---
# EMAIL_PROVIDER: "smtp" (Gmail, Brevo, etc.) ou "outlook_graph" (Outlook/Hotmail
# via Microsoft Graph API com OAuth2).
EMAIL_PROVIDER=smtp

# --- Opção A: SMTP (Brevo, Gmail, etc.) ---
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sistema de Atualização Cadastral CODEGO

# --- Opção B: Outlook/Hotmail via Microsoft Graph (EMAIL_PROVIDER=outlook_graph) ---
# Veja o passo a passo completo no README do projeto sistema_cadastral_codego
# (cadastro do app no Azure + login único via scripts/setup_outlook_auth.py).
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=consumers
OUTLOOK_SENDER_EMAIL=
OUTLOOK_TOKEN_CACHE_PATH=/app/storage/outlook_token_cache.bin
